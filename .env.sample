# ─────────────────────────────────────────────────────────────
# Sample environment file — copy to .env and fill in your values:
#   cp .env.sample .env
# ─────────────────────────────────────────────────────────────

# OpenWeatherMap API key.
# Get one for free at: https://openweathermap.org/api
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key_here

# Redis connection URL (optional).
# Used for caching weather responses. If Redis is unavailable,
# the app falls back gracefully without caching.
REDIS_URL=redis://localhost:6379

# Redis module on/off switch (optional, enabled by default).
# false | off | 0 | no — the Redis client is not created at all,
# caching is fully disabled and every request goes straight to the API.
# REDIS_ENABLED=true
